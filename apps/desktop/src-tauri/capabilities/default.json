{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for OncoWatch.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "updater:default",
    "notification:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "oncowatch-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
